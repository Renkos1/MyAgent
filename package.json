{
  "name": "myagent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "一个能回答「关于这个仓库」的问题的 AI Agent",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node src/index.ts",
    "check": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "contracts": "node scripts/check-contracts.ts src/domain",
    "glossary": "node scripts/check-glossary.ts",
    "verify": "pnpm check && pnpm lint && pnpm format:check && pnpm contracts && pnpm glossary && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^4.1.11",
    "dependency-cruiser": "^18.2.0",
    "eslint": "^10.9.1",
    "fast-check": "^4.9.0",
    "globals": "^17.11.0",
    "prettier": "3.9.6",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@11.15.1"
}
