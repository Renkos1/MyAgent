# 复制成 .env 再填。.env 已经在 .gitignore 里，不会被提交。
# SAFETY: 真实的 key 只放 .env，不放这里、不放代码、不粘进对话。

# provider 的 key。DeepSeek 用它自己的 key。
SMOKE_AUTH_TOKEN=

# Anthropic 官方留空即可；DeepSeek 兼容端点填下面这个。
SMOKE_BASE_URL=https://api.deepseek.com/anthropic

# 可选。DeepSeek 按 claude-* 的档位映射：opus → v4-pro，haiku → v4-flash。
SMOKE_MODEL=claude-haiku-4-5-20251001

# 可选。单次响应的 token 上限。
SMOKE_MAX_TOKENS=1024
