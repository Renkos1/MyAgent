# 顶层配置：编辑器向上查找到这里就不再往上找
root = true

[*]
charset = utf-8
end_of_line = lf                 # 和 .gitattributes 的 eol=lf 对齐
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.md]
# Markdown 行尾两个空格 = 硬换行，不能被 trim 掉
trim_trailing_whitespace = false

[*.{bat,cmd,ps1}]              # Windows 脚本例外
end_of_line = crlf             # 必须 CRLF
